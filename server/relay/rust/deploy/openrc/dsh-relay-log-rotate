#!/bin/sh
# 切分中转日志：超过 20MB 才切，最多留 3 份。
#
# 为什么是「复制 + 原地截断」，不是「改名 + 新建」：supervise-daemon 启动时把
# relay.log 打开成一个 fd 就一直握着（实测 O_APPEND，截断后从 0 继续写），改名换新文件
# 不会让它重新打开——新内容会继续写进被改名的那份，relay.log 永远空着。
# 原地截断动的是同一个 inode，进程那边完全不用管。
#
# 装法：install -m 0755 dsh-relay-log-rotate /etc/periodic/daily/
#       ln -s /etc/periodic/daily/dsh-relay-log-rotate /etc/periodic/hourly/dsh-relay-log-rotate
# 由 busybox crond 跑 run-parts 触发（/etc/crontabs/root 里 daily 是 02:00、hourly 是每小时
# 第 0 分钟）。**daily 和 hourly 都要挂**：这个脚本只按日志自己的大小判断，只在 daily 挂的
# 话每天才检查一次，两次检查之间日志能长到任意大——20MiB 只是下限，不是上限。
# 不用装 logrotate：Alpine 自带的这套够了，也不多一个包。
#
# 注意它**不看磁盘剩余空间**：别的进程把盘写满时，这个脚本一个字节都不会动。
# 它保证的是「日志不会自己长成吞掉整块盘的东西」，不是「磁盘告急时救场」。
set -eu

LOG=${DSH_RELAY_LOG:-/opt/dsh-relay/logs/relay.log}
MAX_BYTES=${DSH_RELAY_LOG_MAX_BYTES:-$((20 * 1024 * 1024))}
KEEP=3

[ -f "$LOG" ] || exit 0

size=$(wc -c < "$LOG")
[ "$size" -ge "$MAX_BYTES" ] || exit 0

i=$KEEP
while [ "$i" -gt 1 ]; do
	prev=$((i - 1))
	if [ -f "$LOG.$prev" ]; then
		mv -f "$LOG.$prev" "$LOG.$i"
	fi
	i=$prev
done
cp "$LOG" "$LOG.1"
: > "$LOG"
echo "dsh-relay: relay.log 已切成 relay.log.1（切前 $size 字节，保留 $KEEP 份）"
